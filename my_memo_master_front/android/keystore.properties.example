# Copier ce fichier en `keystore.properties` (même dossier, NON versionné) et renseigner les valeurs.
# Génération de la clé (à faire UNE fois, puis la sauvegarder hors du dépôt — la perdre empêche toute mise à jour) :
#   keytool -genkeypair -v -keystore mymemomaster-release.jks -alias mymemomaster -keyalg RSA -keysize 2048 -validity 10000
storeFile=C:/chemin/vers/mymemomaster-release.jks
storePassword=
keyAlias=mymemomaster
keyPassword=
