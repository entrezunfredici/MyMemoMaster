# Build de l'application mobile Android : `npm run build:mobile:prod` (vite build --mode mobile).
# Valeurs PUBLIQUES (URLs), pas de secret : versionnable.
# L'API doit répondre en HTTPS et autoriser l'origine https://localhost (CORS_ORIGIN) — c'est l'origine
# de la WebView Capacitor (androidScheme: https).
VITE_API_URL=https://api.my-memo-master.com/api/v1
VITE_FRONT_URL=https://app.my-memo-master.com
