# =============================================================================
#  Modèle du Secret Kubernetes attendu par le chart Helm
#
#  Le chart NE crée PAS ce Secret (il contient des valeurs sensibles qui n'ont
#  rien à faire dans le dépôt). Il est créé à la main, une fois par namespace.
#
#  1. Copier ce fichier en `secrets.env` (ignoré par git) et remplir les valeurs
#  2. Créer le Secret :
#       kubectl create secret generic mmm-prod-secrets \
#         -n mymemomaster --from-env-file=k8s/secrets.env
#       kubectl create secret generic mmm-preprod-secrets \
#         -n mymemomaster-preprod --from-env-file=k8s/secrets.env
#  3. Supprimer `secrets.env` du disque
#
#  Pour faire tourner une valeur plus tard :
#       kubectl create secret generic mmm-prod-secrets -n mymemomaster \
#         --from-env-file=k8s/secrets.env --dry-run=client -o yaml | kubectl apply -f -
# =============================================================================

# ── Base de données (StatefulSet postgres + API) ─────────────────────────────
PG_USER=
PG_PASS=

# ── Redis (StatefulSet/Deployment redis + API) ───────────────────────────────
REDIS_PASS=

# ── Authentification (API) ───────────────────────────────────────────────────
# Signature HS256 des JWT (Auth.middleware.js). Chaîne longue et aléatoire.
AUTH_JWT_SECRET=

# ── Compte administrateur initial (seeders) ──────────────────────────────────
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── SMTP Hostinger (envoi d'emails) ──────────────────────────────────────────
SMTP_USER=
SMTP_PASS=

# ── S3 Infomaniak Swiss Backup (fichiers utilisateurs) ───────────────────────
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── PgAdmin — preprod uniquement (pgadmin.enabled: true) ─────────────────────
PGADMIN_DEFAULT_PASSWORD=

# ── Alertmanager — uniquement si monitoring.alerting.enabled: true ───────────
# DISCORD_WEBHOOK_URL=
