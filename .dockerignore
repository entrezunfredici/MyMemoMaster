# Ignorer les répertoires de dépendances
node_modules
npm-debug.log

# Ignorer les fichiers de configuration de l'éditeur
.vscode
.idea

# Ignorer les fichiers de contrôle de version
.git
.gitignore


# Ignorer les fichiers de logs
logs
*.log

# Ignorer les fichiers temporaires
tmp
*.tmp

# Fichiers d'environnement — JAMAIS dans une image.
# my_memo_master_api/.env contient AUTH_JWT_SECRET, SMTP_USER et SMTP_PASS ;
# le `COPY . .` du Dockerfile les embarquerait dans une image construite en
# local. Les images du CD sont batties depuis un checkout propre (ou .env est
# ignore par git) et n'etaient donc pas concernees, mais rien n'empechait un
# `docker build` local d'etre pousse. Signale par docker:S6470.
.env
.env.*
!.env.example
!.env.ci
