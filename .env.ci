# =============================================================================
#  .env.ci — environnement de la stack docker-compose utilisée par le job
#  `e2e_and_load` de la CI (parcours QA.03/QA.05 et charge QA.06).
#
#  AUCUNE VALEUR RÉELLE ICI, ET C'EST VOLONTAIRE. Ce fichier est committé ;
#  il ne sert qu'à faire démarrer une stack jetable sur un runner GitHub, qui
#  vit le temps d'un job puis disparaît avec la machine. Les mots de passe
#  ci-dessous sont des chaînes factices assumées : ils ne donnent accès à rien
#  au-delà d'un conteneur éphémère sans données.
#
#  Ne JAMAIS s'en servir ailleurs. Les vraies valeurs vivent dans `.env`
#  (ignoré par git) et dans les Secrets GitHub.
# =============================================================================

# ── Identité de la stack ─────────────────────────────────────────────────────
ENVIRONMENT=ci
NODE_ENV=development
COMPOSE_PROFILES=dev

IMAGE_API=mymemomaster_ci_api:local
IMAGE_FRONT=mymemomaster_ci_front:local
IMAGE_TAG=local
DOCKERHUB_USERNAME=unused

# ── Réseau ───────────────────────────────────────────────────────────────────
# Traefik écoute sur :80 et route par en-tête Host. Le runner atteint donc la
# stack entière sur http://localhost.
API_DOMAIN=localhost
FRONT_DOMAIN=localhost
PGADMIN_DOMAIN=pgadmin.localhost
API_PORT=3000
VITE_PORT=80
PGADMIN_PORT=5051
VITE_API_URL=http://localhost/api/v1
VITE_FRONT_URL=http://localhost
APP_FRONT_URL=http://localhost
APP_PUBLIC_URL=http://localhost
URL=http://localhost

# ── Base de données ──────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=mmm_ci
PG_PASS=ci_not_a_real_password
PG_DB=mymemomaster_ci
BDD=mymemomaster_ci
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_POOL_ACQUIRE=30000
PG_POOL_IDLE=10000
DB_SYNC_MAX_RETRIES=5
DB_SYNC_RETRY_DELAY=5000

# ── Authentification ─────────────────────────────────────────────────────────
AUTH_JWT_SECRET=ci_jwt_secret_not_used_outside_throwaway_containers
AUTH_JWT_EXPIRES_IN=1d
API_BYPASS_AUTH=false
MAX_USERS=

# ── Comptes de test ──────────────────────────────────────────────────────────
# L'admin est créé par le seeder existant ; il est nécessaire aux parcours,
# lui seul pouvant créer un groupe classe (rôles 1 et 4).
ADMIN_SEED_EMAIL=admin@mymemomaster.local
ADMIN_SEED_PASSWORD=CiAdmin1234!

# Opt-in explicite du seeder des comptes E2E (double verrou : le seeder refuse
# aussi de s'exécuter si NODE_ENV vaut production).
SEED_E2E_USERS=true
E2E_STUDENT_EMAIL=e2e-student@mymemomaster.local
E2E_STUDENT_PASSWORD=E2eStudent1234!
E2E_TEACHER_EMAIL=e2e-teacher@mymemomaster.local
E2E_TEACHER_PASSWORD=E2eTeacher1234!

# ── Limitation de débit ──────────────────────────────────────────────────────
# Neutralisée pour que le test de charge mesure l'API et non le limiteur
# (500 req/15 min par utilisateur en temps normal). Voir load-tests/api-load.js.
RATE_LIMIT_DISABLED=true

# ── Messagerie (jamais contactée) ────────────────────────────────────────────
# Aucun envoi n'est déclenché par les parcours : les comptes sont pré-validés
# en base, donc aucun email de vérification n'est émis.
EMAIL_FROM=noreply@mymemomaster.local
EMAIL_USER=unused
EMAIL_PASS=unused
MAIL=unused
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=unused
SMTP_PASS=unused

# ── PgAdmin (démarré par le profil dev, non utilisé par les tests) ───────────
PGADMIN_DEFAULT_EMAIL=admin@mymemomaster.local
PGADMIN_DEFAULT_PASSWORD=CiPgAdmin1234!
PASSWORD=CiPgAdmin1234!

# ── Stockage S3 (non sollicité par les parcours) ─────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ── Divers ───────────────────────────────────────────────────────────────────
# ATTENTION : les valeurs de ce fichier doivent rester SANS ESPACE et sans
# quotes. Docker Compose les lirait sans peine, mais la CI en source une
# partie avec `.` : bash y verrait alors une commande a executer.
# `VITE_APP_DESCRIPTION=Stack CI ephemere` a produit « CI: command not found »
# et un exit 127 (run 33303382884).
CLOUDFLARE_API_TOKEN=unused
VITE_APP_NAME=MyMemoMaster
VITE_APP_SHORT_NAME=MMM
VITE_APP_DESCRIPTION=Stack-CI-ephemere
VITE_APP_AUTHOR_NAME=CI
VITE_APP_COMPANY_NAME=CI
VITE_APP_THEME_COLOR=#1E3BA1
VITE_APP_BG_COLOR=#ffffff

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
