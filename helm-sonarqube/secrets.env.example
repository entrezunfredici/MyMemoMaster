# =============================================================================
#  secrets.env.example — modele du Secret K8s de SonarQube
#
#  Meme convention que le chart applicatif : le Secret est cree A LA MAIN sur
#  le cluster et n'est JAMAIS committe. Copier ce fichier en secrets.env,
#  renseigner les valeurs, puis :
#
#    kubectl create namespace sonarqube
#    kubectl -n sonarqube create secret generic sonarqube-secrets \
#      --from-env-file=helm-sonarqube/secrets.env
#
#  Le nom par defaut attendu par le chart est {release}-secrets, soit
#  « sonarqube-secrets » pour la release « sonarqube » (cf. _helpers.tpl).
#
#  ATTENTION : PG_PASS est lu par PostgreSQL au PREMIER demarrage seulement
#  (initdb). Le changer ensuite ne change pas le mot de passe dans la base et
#  casse la connexion JDBC de SonarQube — il faut alors le modifier aussi dans
#  PostgreSQL (ALTER USER ... PASSWORD ...).
# =============================================================================

# Compte PostgreSQL dedie a SonarQube (proprietaire de la base « sonar »)
PG_USER=sonar
PG_PASS=CHANGE_ME
